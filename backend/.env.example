# Server Configuration (Use 5001 on macOS to avoid AirPlay conflict on 5000)
PORT=5001
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# For local MongoDB: mongodb://localhost:27017/cartiva
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cartiva?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cartiva

# JWT Authentication Secret (Placeholder: replace with your secure secret in your private .env)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Cross-Origin Resource Sharing (CORS) Configuration
# Primary production frontend URL (e.g. Vercel deployment)
FRONTEND_URL=https://cartiva-ecommerce.vercel.app

# Additional comma-separated allowed origins (e.g. custom domains, preview URLs)
ALLOWED_ORIGINS=https://cartiva-ecommerce.vercel.app
