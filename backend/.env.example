# Server Configuration (Use 5001 on macOS to avoid AirPlay conflict on 5000)
PORT=5001
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# For local MongoDB: mongodb://localhost:27017/cartiva
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cartiva?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cartiva

# JWT Authentication Secret (Use a strong random key in production)
JWT_SECRET=cartiva_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRE=30d
